# =============================================================================
# Elite Tech Academy — environment variables
#
# Copy this file to `.env` (same folder) and adjust:   cp .env.example .env
# The real `.env` is git-ignored. NEVER commit real secrets.
# In staging/production these values come from the hosting provider's
# secrets manager, not from a file (spec §9.7).
#
# Every value is validated at startup; a missing or malformed value stops the
# app with a clear message.
# =============================================================================

# ---- General -----------------------------------------------------------------
# development | test | production
NODE_ENV=development

# ---- Web app (apps/web, Next.js) ---------------------------------------------
# Public origin of the website. Used for links in emails and the CSRF Origin check.
WEB_ORIGIN=http://localhost:3000
# Where the web server forwards /api/* (the browser only ever talks to WEB_ORIGIN,
# so session cookies stay first-party).
API_INTERNAL_URL=http://localhost:4000

# ---- API (apps/api, NestJS) --------------------------------------------------
API_PORT=4000
# Header that holds the real visitor IP, set (overwritten) by the edge in front of
# the site, e.g. cf-connecting-ip behind Cloudflare. Used for rate limits and audit logs.
# Leave empty locally. X-Forwarded-For is never trusted (browsers can forge it).
# The API must only be reachable through the web app / edge, never directly.
CLIENT_IP_HEADER=
# Serve the OpenAPI docs at /docs (keep false in production).
OPENAPI_ENABLED=true
# Show illustrative graduate stories (placeholders) — development only; refused in production.
SHOW_EXAMPLE_CONTENT=true

# ---- PostgreSQL ----------------------------------------------------------------
# Used by docker-compose to create the local database.
POSTGRES_USER=eta
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=eta
POSTGRES_PORT=5432
# Connection string used by the API and Prisma. Must match the values above locally.
DATABASE_URL=postgresql://eta:change-me-local-only@127.0.0.1:5432/eta

# ---- Redis (rate limits, job queues) ----------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# ---- Security secrets ----------------------------------------------------------
# 32 random bytes, base64. Encrypts 2FA secrets in the database (AES-256-GCM).
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes existing 2FA enrolments unreadable (users must re-enrol).
FIELD_ENCRYPTION_KEY=

# ---- Sessions (spec §9.1) ----------------------------------------------------
# Idle timeout for staff (instructor, mentor, sales, admin), in minutes.
SESSION_STAFF_IDLE_MINUTES=30
# Idle timeout for students, in days.
SESSION_STUDENT_IDLE_DAYS=7
# Absolute session lifetime for everyone, in days.
SESSION_ABSOLUTE_DAYS=30

# ---- Sign-in protection (spec §9.1, §9.4) -----------------------------------
# Failed attempts before an account is locked.
LOGIN_MAX_FAILURES=5
# How long the account stays locked, in minutes.
LOGIN_LOCK_MINUTES=15
# Failed attempts after which a captcha is required.
LOGIN_CAPTCHA_AFTER_FAILURES=3
# General API limit per IP, requests per minute.
RATE_LIMIT_PER_MINUTE=100

# ---- Links sent by email -----------------------------------------------------
INVITATION_TTL_HOURS=72
PASSWORD_RESET_TTL_MINUTES=30

# ---- Two-step verification ---------------------------------------------------
# Name shown in the authenticator app.
TOTP_ISSUER=Elite Tech Academy

# ---- Captcha: Cloudflare Turnstile -------------------------------------------
# The defaults below are Cloudflare's official TEST keys (always pass).
# Replace with real keys from https://dash.cloudflare.com in staging/production.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# ---- Breached-password check (Have I Been Pwned, k-anonymity) ---------------
# Only the first 5 characters of the password's SHA-1 hash ever leave the server.
HIBP_ENABLED=true

# ---- Email -------------------------------------------------------------------
# Locally these point to Mailpit (docker-compose). Inbox: http://localhost:8025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAILPIT_UI_PORT=8025
MAIL_FROM="Elite Tech Academy <no-reply@elitetech.example>"

# ---- Payments (spec §8, §9.5) ------------------------------------------------
# Payment gateway adapter. Only "test" exists until the gateway is chosen
# (Cardcom / Tranzila / Grow, spec §12). "test" is refused in production.
PAYMENT_PROVIDER=test
# Signs the test provider's webhooks (32+ random characters).
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PAYMENT_TEST_SECRET=

# ---- Mentoring sessions (spec §4.5) -------------------------------------------
# How many times a student may move one booked session (0 = never). Cancelling
# stays possible until 24 hours before the session either way.
SESSION_MAX_RESCHEDULES=1

# ---- File storage: lesson materials, exercises, local videos ------------------
# Any S3-compatible service. Development: the "storage" service in docker compose
# (Versity S3 Gateway). Production: Cloudflare R2 or AWS S3 with a private bucket.
STORAGE_ENDPOINT=http://127.0.0.1:9000
# Address the browser uses for short-lived download and video links.
STORAGE_PUBLIC_ENDPOINT=http://127.0.0.1:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=elite-tech-dev
# The development storage service uses these as its keys too (min 8 characters).
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# true for the development storage and R2; false for AWS S3.
STORAGE_FORCE_PATH_STYLE=true
# Create the bucket at startup if it is missing (development only).
STORAGE_CREATE_BUCKET=true

# ---- Virus scanning (ClamAV, spec §9) ---------------------------------------
# Every uploaded file is scanned before students can download it.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# ---- Lesson videos -------------------------------------------------------------
# "local": stored in the file storage above and played as-is (development).
# "cloudflare": Cloudflare Stream (resumable uploads, adaptive streaming, signed links).
VIDEO_PROVIDER=local
# Needed only when VIDEO_PROVIDER=cloudflare. The token needs "Stream: Edit".
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
# From the Stream dashboard, e.g. "customer-abc123" in customer-abc123.cloudflarestream.com
CLOUDFLARE_STREAM_CUSTOMER_CODE=

# ---- Web: where videos and downloads come from --------------------------------
# Space-separated origins the browser may load media from and upload to (CSP).
# Development: the storage address. Cloudflare Stream: https://*.cloudflarestream.com
MEDIA_ORIGINS=http://127.0.0.1:9000

# ---- First admin (pnpm db:seed) ----------------------------------------------
# The seed creates this admin once. Use a strong password (min 10 characters);
# you will be asked to set up two-step verification on first sign-in.
SEED_ADMIN_EMAIL=admin@elitetech.local
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=Academy
SEED_ADMIN_LAST_NAME=Admin

# ---- Development accounts (pnpm db:seed:dev) ----------------------------------
# Password for the example instructor and student accounts created by the dev
# seed (min 10 characters). The dev seed refuses to run in production or when
# SHOW_EXAMPLE_CONTENT is not true. Instructors set up two-step verification
# on first sign-in, like all staff.
SEED_DEV_PASSWORD=
