// Elite Tech Academy — database schema (spec §7).
// Milestone 1: User, UserRole, Session, AuthToken, AuditLog, Consent.
// Conventions: UUID ids, snake_case in the database, camelCase in code,
// created_at/updated_at on every table, times in UTC.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  student
  instructor
  mentor
  sales
  admin
}

enum Locale {
  en
  ar
  he
}

enum UserStatus {
  invited
  active
  deactivated
}

enum AuthTokenType {
  invitation
  password_reset
}

enum ConsentType {
  contact
  marketing
  story
  /// Booking: "I agree to the cancellation policy and terms" (spec §3.7)
  terms
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  /// Always stored lower-case (normalised by the shared Zod schema).
  email         String     @unique
  /// E.164, e.g. +972501234567
  phone         String?
  firstName     String     @map("first_name")
  lastName      String     @map("last_name")
  /// Argon2id hash. Null until the invitation is accepted.
  passwordHash  String?    @map("password_hash")
  locale        Locale     @default(en)
  timeZone      String     @default("Asia/Jerusalem") @map("time_zone")
  /// TOTP secret encrypted with AES-256-GCM (FIELD_ENCRYPTION_KEY). Never returned by the API.
  totpSecretEnc String?    @map("totp_secret_enc")
  totpEnabledAt DateTime?  @map("totp_enabled_at")
  /// Last accepted TOTP time step; a code can never be used twice.
  totpLastStep  Int?       @map("totp_last_step")
  status        UserStatus @default(invited)
  lastLoginAt   DateTime?  @map("last_login_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  deletedAt     DateTime?  @map("deleted_at")

  roles             UserRole[]
  sessions          Session[]
  authTokens        AuthToken[]
  consents          Consent[]
  auditLogs         AuditLog[]
  mentorProfile     MentorProfile?
  ownedLeads        Lead[]             @relation("LeadOwner")
  bookings          Booking[]
  orders            Order[]
  credits           PackageCredit[]
  activities        Activity[]
  tasks             Task[]
  enrollments       Enrollment[]
  announcements     Announcement[]     @relation("AnnouncementAuthor")
  notifications     Notification[]
  attendance        Attendance[]       @relation("AttendanceStudent")
  notesAbout        StudentNote[]      @relation("NoteStudent")
  notesWritten      StudentNote[]      @relation("NoteAuthor")
  lessonProgress    LessonProgress[]
  submissions       Submission[]       @relation("SubmissionStudent")
  graded            Submission[]       @relation("SubmissionGrader")
  studentThreads    Conversation[]     @relation("ConversationStudent")
  staffThreads      Conversation[]     @relation("ConversationStaff")
  messagesSent      Message[]
  threadReads       ConversationRead[]
  discussionThreads DiscussionThread[]
  discussionReplies DiscussionReply[]
  discussionReports DiscussionReport[]
  syllabiUploaded   SyllabusFile[]

  @@map("users")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  role      Role
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

/// Server-side session. The cookie holds a random token; only its SHA-256 hash is stored.
model Session {
  id                String    @id @default(uuid()) @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  userId            String    @map("user_id") @db.Uuid
  /// False until the second step (TOTP) is passed. Such sessions can only reach the 2FA endpoints.
  mfaVerified       Boolean   @default(false) @map("mfa_verified")
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at")
  idleTimeoutSec    Int       @map("idle_timeout_sec")
  absoluteExpiresAt DateTime  @map("absolute_expires_at")
  ip                String?
  userAgent         String?   @map("user_agent")
  revokedAt         DateTime? @map("revoked_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Single-use invitation and password-reset links. Only the SHA-256 hash is stored.
model AuthToken {
  id        String        @id @default(uuid()) @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash")
  userId    String        @map("user_id") @db.Uuid
  expiresAt DateTime      @map("expires_at")
  usedAt    DateTime?     @map("used_at")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

/// Append-only (a database trigger blocks UPDATE and DELETE). Never contains secrets.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  before    Json?
  after     Json?
  ip        String?
  userAgent String?  @map("user_agent")
  at        DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([actorId])
  @@index([at])
  @@map("audit_logs")
}

/// Proof of consent (spec §9.10). The subject is a user, or a lead (added in milestone 3).
model Consent {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String?     @map("user_id") @db.Uuid
  leadId      String?     @map("lead_id") @db.Uuid
  type        ConsentType
  /// Version id of the consent wording, e.g. "contact-2026-10".
  textVersion String      @map("text_version")
  /// Exact wording the person agreed to, in the language shown.
  text        String
  grantedAt   DateTime    @default(now()) @map("granted_at")
  withdrawnAt DateTime?   @map("withdrawn_at")
  ip          String?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  user  User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead  Lead?         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  story SuccessStory?

  @@index([userId])
  @@index([leadId])
  @@map("consents")
}

// ---------------------------------------------------------------------------
// Catalog and public content (milestone 2).
// Text shown to the public is stored per language as JSON: {"en": "...", "ar": "...", "he": "..."}.
// ---------------------------------------------------------------------------

/// Catalog filter (spec §3.2). Labels live in the web translation files.
enum ProgramSubject {
  web
  data
  ai
  devops
}

enum ProgramLevel {
  beginner
  intermediate
  advanced
}

enum CohortStatus {
  open
  full
  running
  finished
}

enum MentorKind {
  instructor
  career
}

model Program {
  id                String         @id @default(uuid()) @db.Uuid
  slug              String         @unique
  /// {en, ar, he}
  title             Json
  /// {en, ar, he} — one-line summary for cards
  summary           Json
  /// {en, ar, he} — course details "Overview" paragraph
  overview          Json?
  /// {en, ar, he} — "Who it is for"
  audience          Json?
  /// {en: [...], ar: [...], he: [...]} — "What you will learn" bullets
  outcomes          Json?
  /// Languages the classes are taught in
  teachingLanguages Locale[]       @map("teaching_languages")
  level             ProgramLevel
  subject           ProgramSubject @default(web)
  /// Null while not decided (spec §12 open item)
  lengthWeeks       Int?           @map("length_weeks")
  /// Short technology tags shown on cards, e.g. ["SQL", "Python", "AI"]
  tags              String[]
  isTop             Boolean        @default(false) @map("is_top")
  topOrder          Int?           @map("top_order")
  published         Boolean        @default(false)
  /// INTERNAL ONLY — never returned by public endpoints (spec §1: no program prices on the website)
  priceAgorot       Int?           @map("price_agorot")
  instructorId      String?        @map("instructor_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  deletedAt         DateTime?      @map("deleted_at")

  instructor MentorProfile?  @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  cohorts    Cohort[]
  modules    ProgramModule[]
  lessons    Lesson[]
  syllabi    SyllabusFile[]
  leads      Lead[]
  faqs       Faq[]
  stories    SuccessStory[]

  @@map("programs")
}

model Cohort {
  id           String       @id @default(uuid()) @db.Uuid
  programId    String       @map("program_id") @db.Uuid
  name         String
  startDate    DateTime     @map("start_date") @db.Date
  /// {days: ["sun","tue"], from: "18:00", to: "21:00"}
  schedule     Json?
  seatsTotal   Int          @map("seats_total")
  seatsTaken   Int          @default(0) @map("seats_taken")
  status       CohortStatus @default(open)
  zoomSeriesId String?      @map("zoom_series_id")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  program       Program            @relation(fields: [programId], references: [id], onDelete: Cascade)
  leads         Lead[]
  enrollments   Enrollment[]
  announcements Announcement[]
  attendance    Attendance[]
  studentNotes  StudentNote[]
  submissions   Submission[]
  discussions   DiscussionThread[]

  @@index([programId, startDate])
  @@map("cohorts")
}

/// Program instructors and career advisors shown on the site (spec §7 MentorProfile).
model MentorProfile {
  id             String     @id @default(uuid()) @db.Uuid
  slug           String     @unique
  /// Linked when the person gets a staff account.
  userId         String?    @unique @map("user_id") @db.Uuid
  kind           MentorKind
  /// {en, ar, he}
  name           Json
  /// {en, ar, he} e.g. "Program instructor and mentor"
  role           Json
  /// {en, ar, he}
  bio            Json
  languages      Locale[]
  /// {en: [...], ar: [...], he: [...]} — topics shown as chips on mentor cards
  skills         Json?
  photoPath      String?    @map("photo_path")
  sessionMinutes Int        @default(60) @map("session_minutes")
  /// Free minutes kept before and after each booked session (design "Instructor 5")
  breakMinutes   Int        @default(15) @map("break_minutes")
  /// Students can book at least this many hours ahead
  minNoticeHours Int        @default(24) @map("min_notice_hours")
  /// Shown first in the landing spotlight (spec §3.1: Dania selected on load).
  featured       Boolean    @default(false)
  sortOrder      Int        @default(0) @map("sort_order")
  active         Boolean    @default(true)
  /// Illustrative placeholder (e.g. career advisors from the design): shown only when SHOW_EXAMPLE_CONTENT=true.
  isExample      Boolean    @default(false) @map("is_example")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  user         User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  programs     Program[]
  availability AvailabilitySlot[]
  bookings     Booking[]
  timeOff      MentorTimeOff[]

  @@map("mentor_profiles")
}

model Faq {
  id        String   @id @default(uuid()) @db.Uuid
  /// Stable identifier used by the seed, e.g. "landing.prior-experience"
  key       String   @unique
  /// Null = general FAQ (landing); set = that program's FAQ
  programId String?  @map("program_id") @db.Uuid
  /// {en, ar, he}
  question  Json
  /// {en, ar, he}
  answer    Json
  sortOrder Int      @default(0) @map("sort_order")
  published Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  program Program? @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@map("faqs")
}

/// Graduate stories (spec §3.1, §9.10): public only when published AND consent is recorded.
model SuccessStory {
  id           String   @id @default(uuid()) @db.Uuid
  key          String   @unique
  personName   String   @map("person_name")
  /// {en, ar, he} e.g. "Web development graduate"
  programLabel Json     @map("program_label")
  /// {en, ar, he} e.g. "Now works as a junior developer"
  outcome      Json?
  /// {en, ar, he}
  quote        Json
  photoPath    String?  @map("photo_path")
  programId    String?  @map("program_id") @db.Uuid
  consentId    String?  @unique @map("consent_id") @db.Uuid
  published    Boolean  @default(false)
  /// Illustrative placeholder: shown only when SHOW_EXAMPLE_CONTENT=true (never in production).
  isExample    Boolean  @default(false) @map("is_example")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  program Program? @relation(fields: [programId], references: [id], onDelete: SetNull)
  consent Consent? @relation(fields: [consentId], references: [id], onDelete: SetNull)

  @@map("success_stories")
}

// ---------------------------------------------------------------------------
// CRM (milestone 3, spec §5): leads, their timeline and follow-up tasks.
// ---------------------------------------------------------------------------

enum LeadSource {
  website_form
  chat_assistant
  facebook
  instagram
  whatsapp
  referral
  webinar
  tiktok
  manual
  import
}

/// One closed list used everywhere (spec §5.2).
enum LeadStage {
  new
  contacted
  interested
  advice_booked
  registered
  lost
}

enum LostReason {
  price
  timing
  other_academy
  not_a_fit
  unreachable
}

enum ActivityType {
  call
  whatsapp
  email
  meeting
  stage_change
  system
}

enum TaskStatus {
  open
  done
  snoozed
}

model Lead {
  id            String      @id @default(uuid()) @db.Uuid
  firstName     String      @map("first_name")
  lastName      String      @map("last_name")
  /// E.164. One lead per phone: a new form from the same phone is merged (spec §3.6).
  phone         String      @unique
  email         String?
  occupation    String?
  programId     String?     @map("program_id") @db.Uuid
  cohortId      String?     @map("cohort_id") @db.Uuid
  source        LeadSource
  stage         LeadStage   @default(new)
  lostReason    LostReason? @map("lost_reason")
  ownerId       String?     @map("owner_id") @db.Uuid
  /// {days: ["sun","tue"], hours: ["evening"]} — when the person prefers to be called
  availability  Json?
  notes         String?
  lastContactAt DateTime?   @map("last_contact_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  deletedAt     DateTime?   @map("deleted_at")

  program    Program?   @relation(fields: [programId], references: [id], onDelete: SetNull)
  cohort     Cohort?    @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  owner      User?      @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  activities Activity[]
  tasks      Task[]
  consents   Consent[]

  @@index([stage])
  @@index([ownerId])
  @@index([createdAt])
  @@map("leads")
}

/// The lead's timeline: calls, messages, stage changes and system events (spec §5.6).
model Activity {
  id         String       @id @default(uuid()) @db.Uuid
  leadId     String       @map("lead_id") @db.Uuid
  type       ActivityType
  outcome    String?
  notes      String?
  /// Null for system events (e.g. "Lead created from website form").
  authorId   String?      @map("author_id") @db.Uuid
  occurredAt DateTime     @default(now()) @map("occurred_at")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  lead   Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([leadId, occurredAt])
  @@map("activities")
}

/// Follow-ups (spec §5.7).
model Task {
  id           String     @id @default(uuid()) @db.Uuid
  leadId       String     @map("lead_id") @db.Uuid
  assigneeId   String?    @map("assignee_id") @db.Uuid
  title        String
  dueAt        DateTime   @map("due_at")
  status       TaskStatus @default(open)
  snoozedUntil DateTime?  @map("snoozed_until")
  completedAt  DateTime?  @map("completed_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  lead     Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignee User? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([assigneeId, status, dueAt])
  @@index([leadId])
  @@map("tasks")
}

/// A unit of a program's curriculum (spec §3.3, §7 Module). Weeks and lessons are added with the syllabus.
model ProgramModule {
  id        String   @id @default(uuid()) @db.Uuid
  programId String   @map("program_id") @db.Uuid
  sortOrder Int      @map("sort_order")
  /// {en, ar, he}
  title     Json
  weekFrom  Int      @map("week_from")
  weekTo    Int      @map("week_to")
  /// {en: [...], ar: [...], he: [...]}
  topics    Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  program Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@unique([programId, sortOrder])
  @@map("program_modules")
}

/// Bookable services and their prices (spec §3.5, §7 Package). Prices always come from here, never from the page.
model Package {
  id             String     @id @default(uuid()) @db.Uuid
  /// Stable code used in links, e.g. "mentoring-8", "career"
  code           String     @unique
  kind           MentorKind
  sessions       Int
  /// Integer agorot: ₪250 = 25000
  priceAgorot    Int        @map("price_agorot")
  /// Length of each session in this package
  sessionMinutes Int        @default(60) @map("session_minutes")
  /// Highlighted as the recommended choice (spec: 8-session plan)
  recommended    Boolean    @default(false)
  sortOrder      Int        @default(0) @map("sort_order")
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  credits  PackageCredit[]
  bookings Booking[]

  @@map("packages")
}

// ---------------------------------------------------------------------------
// Mentoring bookings and payments (milestone 5, spec §3.7, §7, §9.5)
// ---------------------------------------------------------------------------

/// Weekly recurring free time of a mentor, in the mentor's time zone (spec §7 AvailabilitySlot).
model AvailabilitySlot {
  id        String   @id @default(uuid()) @db.Uuid
  mentorId  String   @map("mentor_id") @db.Uuid
  /// 0 = Sunday … 6 = Saturday
  weekday   Int
  /// "HH:MM" local time
  startTime String   @map("start_time")
  endTime   String   @map("end_time")
  timeZone  String   @default("Asia/Jerusalem") @map("time_zone")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  mentor MentorProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([mentorId])
  @@map("availability_slots")
}

enum BookingStatus {
  held
  confirmed
  cancelled
  completed
  no_show
}

enum OrderStatus {
  pending
  paid
  failed
  refunded
}

model Booking {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  mentorId        String        @map("mentor_id") @db.Uuid
  packageId       String        @map("package_id") @db.Uuid
  startAt         DateTime      @map("start_at")
  endAt           DateTime      @map("end_at")
  status          BookingStatus @default(held)
  /// A held slot is kept for 10 minutes while paying (spec §3.7)
  holdExpiresAt   DateTime?     @map("hold_expires_at")
  zoomLink        String?       @map("zoom_link")
  /// Mentor's notes after the session; the student sees them (max 2,000 characters)
  notes           String?
  notesAt         DateTime?     @map("notes_at")
  /// Times the student moved this session; limited by SESSION_MAX_RESCHEDULES
  rescheduleCount Int           @default(0) @map("reschedule_count")
  cancelledAt     DateTime?     @map("cancelled_at")
  cancelledBy     CancelledBy?  @map("cancelled_by")
  creditId        String?       @map("credit_id") @db.Uuid
  orderId         String?       @map("order_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  mentor  MentorProfile  @relation(fields: [mentorId], references: [id], onDelete: Restrict)
  package Package        @relation(fields: [packageId], references: [id], onDelete: Restrict)
  credit  PackageCredit? @relation(fields: [creditId], references: [id], onDelete: SetNull)
  order   Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([mentorId, startAt])
  @@map("bookings")
}

/// Money in integer agorot; created before the redirect, changed only by the provider's webhook (spec §7, §9.5).
model Order {
  id                String      @id @default(uuid()) @db.Uuid
  userId            String      @map("user_id") @db.Uuid
  /// [{packageCode, sessions, priceAgorot}] — snapshot at purchase time
  items             Json
  amountAgorot      Int         @map("amount_agorot")
  currency          String      @default("ILS")
  status            OrderStatus @default(pending)
  provider          String
  providerTxnId     String?     @unique @map("provider_txn_id")
  failureReason     String?     @map("failure_reason")
  installments      Int         @default(1)
  /// Set when a paid single session is cancelled in time; admin completes the refund in the gateway
  refundRequestedAt DateTime?   @map("refund_requested_at")
  receiptFileId     String?     @map("receipt_file_id") @db.Uuid
  paidAt            DateTime?   @map("paid_at")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  user     User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  bookings Booking[]
  credits  PackageCredit[]

  @@index([userId])
  @@map("orders")
}

/// Sessions bought in a package (8-session plan = 8 credits, spec §3.7).
model PackageCredit {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  packageId String   @map("package_id") @db.Uuid
  orderId   String?  @map("order_id") @db.Uuid
  mentorId  String?  @map("mentor_id") @db.Uuid
  total     Int
  used      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  package  Package   @relation(fields: [packageId], references: [id], onDelete: Restrict)
  order    Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  bookings Booking[]

  @@index([userId])
  @@map("package_credits")
}

/// Every provider webhook we accepted, so the same event twice does nothing (spec §9.5).
model PaymentEvent {
  id         String   @id @default(uuid()) @db.Uuid
  provider   String
  eventId    String   @map("event_id")
  orderId    String?  @map("order_id") @db.Uuid
  type       String
  receivedAt DateTime @default(now()) @map("received_at")

  @@unique([provider, eventId])
  @@map("payment_events")
}

// ── Teaching: enrollments, announcements, notifications (instructor milestone 1) ──

enum EnrollmentStatus {
  /// Chosen by the student; waiting for admin or sales to confirm (payment arranged)
  pending
  confirmed
  withdrawn
}

/// A student in a cohort. Lessons, materials and announcements are visible only when confirmed.
model Enrollment {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  cohortId      String           @map("cohort_id") @db.Uuid
  status        EnrollmentStatus @default(pending)
  confirmedAt   DateTime?        @map("confirmed_at")
  /// Staff user who confirmed (admin or sales)
  confirmedById String?          @map("confirmed_by_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Restrict)

  @@unique([userId, cohortId])
  @@index([cohortId, status])
  @@map("enrollments")
}

/// Posted by the cohort's instructor; every confirmed student is notified.
model Announcement {
  id        String   @id @default(uuid()) @db.Uuid
  cohortId  String   @map("cohort_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  title     String
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  author User   @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([cohortId, createdAt])
  @@map("announcements")
}

enum NotificationType {
  announcement
  enrollment_confirmed
  session_booked
  session_cancelled
  session_rescheduled
  session_notes
  submission_returned
  discussion_question
  discussion_reply
  discussion_report
}

/// In-app notification (bell). "data" holds ids and names; the web app writes the sentence
/// in the reader's language.
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  data      Json
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

enum CancelledBy {
  student
  mentor
}

/// Days a mentor is away: no sessions can be booked (design "Instructor 5" Time off).
model MentorTimeOff {
  id        String   @id @default(uuid()) @db.Uuid
  mentorId  String   @map("mentor_id") @db.Uuid
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  createdAt DateTime @default(now()) @map("created_at")

  mentor MentorProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([mentorId, endDate])
  @@map("mentor_time_off")
}

// ── Progress & attendance (design "Instructor 2–3") ──

enum AttendanceStatus {
  present
  late
  absent
}

/// One student at one live class of a cohort (the class day, Jerusalem calendar).
model Attendance {
  id         String           @id @default(uuid()) @db.Uuid
  cohortId   String           @map("cohort_id") @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  classDate  DateTime         @map("class_date") @db.Date
  status     AttendanceStatus
  markedById String           @map("marked_by_id") @db.Uuid
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  user   User   @relation("AttendanceStudent", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cohortId, userId, classDate])
  @@index([cohortId, classDate])
  @@map("attendance")
}

/// Instructor's note about a student. Staff only: never shown to the student.
model StudentNote {
  id                   String   @id @default(uuid()) @db.Uuid
  cohortId             String   @map("cohort_id") @db.Uuid
  studentId            String   @map("student_id") @db.Uuid
  authorId             String   @map("author_id") @db.Uuid
  body                 String
  /// Also visible to admissions (e.g. a student who may drop out)
  sharedWithAdmissions Boolean  @default(false) @map("shared_with_admissions")
  createdAt            DateTime @default(now()) @map("created_at")

  cohort  Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  student User   @relation("NoteStudent", fields: [studentId], references: [id], onDelete: Cascade)
  author  User   @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([cohortId, studentId, createdAt])
  @@map("student_notes")
}

// ── Course content (design "Instructor 6", spec §4.8) ──

enum LessonStatus {
  draft
  published
}

/// A lesson of a program, shared by every cohort of that program.
model Lesson {
  id                String       @id @default(uuid()) @db.Uuid
  programId         String       @map("program_id") @db.Uuid
  moduleId          String?      @map("module_id") @db.Uuid
  /// Order within the program (1, 2, 3…)
  position          Int
  title             String
  about             String       @default("")
  status            LessonStatus @default(draft)
  /// Students can open it from this week of their cohort (null: as soon as published)
  availableFromWeek Int?         @map("available_from_week")
  publishedAt       DateTime?    @map("published_at")
  createdById       String       @map("created_by_id") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  program    Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  module     ProgramModule?   @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  videos     LessonVideo[]
  files      LessonFile[]
  progress   LessonProgress[]
  assignment Assignment?

  @@index([programId, position])
  @@map("lessons")
}

enum VideoStatus {
  uploading
  processing
  ready
  failed
}

model LessonVideo {
  id              String      @id @default(uuid()) @db.Uuid
  lessonId        String      @map("lesson_id") @db.Uuid
  /// "local" or "cloudflare"
  provider        String
  /// Storage key (local) or Cloudflare Stream video id
  providerVideoId String      @map("provider_video_id")
  fileName        String      @map("file_name")
  sizeBytes       BigInt      @map("size_bytes")
  durationSec     Int?        @map("duration_sec")
  status          VideoStatus @default(uploading)
  position        Int
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, position])
  @@map("lesson_videos")
}

enum LessonFileKind {
  material
  exercise
}

enum ScanStatus {
  scanning
  clean
  infected
  failed
}

/// A download for students. Only downloadable once the virus scan says clean.
model LessonFile {
  id            String         @id @default(uuid()) @db.Uuid
  lessonId      String         @map("lesson_id") @db.Uuid
  kind          LessonFileKind
  fileName      String         @map("file_name")
  contentType   String         @map("content_type")
  sizeBytes     Int            @map("size_bytes")
  storageKey    String         @map("storage_key")
  scanStatus    ScanStatus     @default(scanning) @map("scan_status")
  scanSignature String?        @map("scan_signature")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@map("lesson_files")
}

/// A student's place in a lesson: where the video was left, and whether it is complete.
model LessonProgress {
  userId      String    @map("user_id") @db.Uuid
  lessonId    String    @map("lesson_id") @db.Uuid
  positionSec Int       @default(0) @map("position_sec")
  completedAt DateTime? @map("completed_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
  @@map("lesson_progress")
}

/// The exercise of a lesson that students hand in (design "Instructor 4"). The
/// deadline is a week of each cohort, so every cohort gets its own date.
model Assignment {
  id           String   @id @default(uuid()) @db.Uuid
  lessonId     String   @unique @map("lesson_id") @db.Uuid
  title        String
  instructions String   @default("")
  /// Due at the end of this week of the student's cohort (Saturday 23:59, Jerusalem)
  dueWeek      Int      @map("due_week")
  /// [{id, title, maxPoints}]; the points add up to 100
  rubric       Json
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  lesson      Lesson             @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  submissions Submission[]
  discussions DiscussionThread[]

  @@map("assignments")
}

enum SubmissionStatus {
  /// Handed in; the student can still change it
  submitted
  /// Graded and returned: the student sees the grade and feedback
  returned
}

/// A student's work for an assignment. Late work is accepted and shown as late.
model Submission {
  id           String           @id @default(uuid()) @db.Uuid
  assignmentId String           @map("assignment_id") @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  cohortId     String           @map("cohort_id") @db.Uuid
  repoUrl      String?          @map("repo_url")
  note         String           @default("")
  submittedAt  DateTime         @map("submitted_at")
  status       SubmissionStatus @default(submitted)
  /// [{criterionId, points, comment}] — a draft until returned
  scores       Json?
  feedback     String           @default("")
  /// Sum of the points, 0–100
  score        Int?
  gradedById   String?          @map("graded_by_id") @db.Uuid
  gradedAt     DateTime?        @map("graded_at")
  returnedAt   DateTime?        @map("returned_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  assignment Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User             @relation("SubmissionStudent", fields: [userId], references: [id], onDelete: Cascade)
  cohort     Cohort           @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  gradedBy   User?            @relation("SubmissionGrader", fields: [gradedById], references: [id], onDelete: SetNull)
  files      SubmissionFile[]

  @@unique([assignmentId, userId])
  @@index([cohortId, status])
  @@map("submissions")
}

/// A file handed in with a submission; downloadable only once the virus scan says clean.
model SubmissionFile {
  id            String     @id @default(uuid()) @db.Uuid
  submissionId  String     @map("submission_id") @db.Uuid
  fileName      String     @map("file_name")
  contentType   String     @map("content_type")
  sizeBytes     Int        @map("size_bytes")
  storageKey    String     @map("storage_key")
  scanStatus    ScanStatus @default(scanning) @map("scan_status")
  scanSignature String?    @map("scan_signature")
  createdAt     DateTime   @default(now()) @map("created_at")

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("submission_files")
}

enum ConversationKind {
  /// The student and one instructor or mentor
  direct
  /// The student and the Support team (admins)
  support
  /// The student and the Payments team (admins and sales)
  payments
}

/// A thread in Messages & support (spec §4.9). Always has a student: students
/// never message other students, and staff talk to students only.
model Conversation {
  id            String           @id @default(uuid()) @db.Uuid
  kind          ConversationKind
  studentId     String           @map("student_id") @db.Uuid
  /// The instructor or mentor of a direct thread; null for team threads
  staffId       String?          @map("staff_id") @db.Uuid
  subject       String           @default("")
  lastMessageAt DateTime         @default(now()) @map("last_message_at")
  createdAt     DateTime         @default(now()) @map("created_at")

  student  User               @relation("ConversationStudent", fields: [studentId], references: [id], onDelete: Cascade)
  staff    User?              @relation("ConversationStaff", fields: [staffId], references: [id], onDelete: Cascade)
  messages Message[]
  reads    ConversationRead[]

  @@unique([studentId, kind, staffId])
  @@index([staffId, lastMessageAt])
  @@index([kind, lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  senderId       String   @map("sender_id") @db.Uuid
  body           String
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                @relation(fields: [senderId], references: [id], onDelete: Cascade)
  attachments  MessageAttachment[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

/// A file sent with a message; downloadable only once the virus scan says clean.
model MessageAttachment {
  id            String     @id @default(uuid()) @db.Uuid
  messageId     String     @map("message_id") @db.Uuid
  fileName      String     @map("file_name")
  contentType   String     @map("content_type")
  sizeBytes     Int        @map("size_bytes")
  storageKey    String     @map("storage_key")
  scanStatus    ScanStatus @default(scanning) @map("scan_status")
  scanSignature String?    @map("scan_signature")
  createdAt     DateTime   @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("message_attachments")
}

/// Up to when a participant has read a thread (unread = newer messages from others).
model ConversationRead {
  conversationId String   @map("conversation_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  lastReadAt     DateTime @map("last_read_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@map("conversation_reads")
}

// ---------------------------------------------------------------------------
// Assignment discussions (spec §4.11): classmates of one cohort ask and answer
// questions about an exercise; the cohort's instructor moderates.
// ---------------------------------------------------------------------------

enum DiscussionRemovedBy {
  /// The writer deleted their own post
  author
  /// The instructor or an admin removed it
  staff
}

/// A question about an assignment. Only the cohort's confirmed students, the
/// program's instructor and admins can see it.
model DiscussionThread {
  id             String               @id @default(uuid()) @db.Uuid
  assignmentId   String               @map("assignment_id") @db.Uuid
  cohortId       String               @map("cohort_id") @db.Uuid
  authorId       String               @map("author_id") @db.Uuid
  title          String
  body           String
  /// Kept at the top of the list by the instructor
  pinned         Boolean              @default(false)
  /// The reply the instructor marked as the answer
  answerReplyId  String?              @unique @map("answer_reply_id") @db.Uuid
  removedAt      DateTime?            @map("removed_at")
  removedBy      DiscussionRemovedBy? @map("removed_by")
  /// Newest post in the thread; the list is sorted by it
  lastActivityAt DateTime             @default(now()) @map("last_activity_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  assignment Assignment         @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  cohort     Cohort             @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  author     User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  answer     DiscussionReply?   @relation("ThreadAnswer", fields: [answerReplyId], references: [id], onDelete: SetNull)
  replies    DiscussionReply[]  @relation("ThreadReplies")
  reports    DiscussionReport[]

  @@index([cohortId, assignmentId, lastActivityAt])
  @@map("discussion_threads")
}

model DiscussionReply {
  id        String               @id @default(uuid()) @db.Uuid
  threadId  String               @map("thread_id") @db.Uuid
  authorId  String               @map("author_id") @db.Uuid
  body      String
  removedAt DateTime?            @map("removed_at")
  removedBy DiscussionRemovedBy? @map("removed_by")
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")

  thread   DiscussionThread   @relation("ThreadReplies", fields: [threadId], references: [id], onDelete: Cascade)
  answerOf DiscussionThread?  @relation("ThreadAnswer")
  author   User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reports  DiscussionReport[]

  @@index([threadId, createdAt])
  @@map("discussion_replies")
}

/// A student flags a question (replyId null) or a reply for the instructor.
model DiscussionReport {
  id         String    @id @default(uuid()) @db.Uuid
  threadId   String    @map("thread_id") @db.Uuid
  replyId    String?   @map("reply_id") @db.Uuid
  reporterId String    @map("reporter_id") @db.Uuid
  reason     String    @default("")
  /// Set when the instructor removes the post or keeps it
  resolvedAt DateTime? @map("resolved_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  thread   DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  reply    DiscussionReply? @relation(fields: [replyId], references: [id], onDelete: Cascade)
  reporter User             @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([threadId, resolvedAt])
  @@map("discussion_reports")
}

/// A program's syllabus PDF, uploaded by its instructor or an admin. Only the
/// newest clean file counts; older ones are removed once a newer one passes
/// the virus scan. Confirmed students, the instructor and admins can open it.
model SyllabusFile {
  id            String     @id @default(uuid()) @db.Uuid
  programId     String     @map("program_id") @db.Uuid
  fileName      String     @map("file_name")
  sizeBytes     Int        @map("size_bytes")
  storageKey    String     @map("storage_key")
  scanStatus    ScanStatus @default(scanning) @map("scan_status")
  scanSignature String?    @map("scan_signature")
  uploadedById  String?    @map("uploaded_by_id") @db.Uuid
  createdAt     DateTime   @default(now()) @map("created_at")

  program    Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  uploadedBy User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([programId, createdAt])
  @@map("syllabus_files")
}
