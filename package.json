{
  "name": "elite-tech-academy",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint && pnpm run lint:logical-css",
    "lint:logical-css": "node scripts/check-logical-css.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @eta/db migrate:dev",
    "db:seed": "pnpm --filter @eta/api build && pnpm --filter @eta/api seed",
    "test:integration": "turbo run test:integration",
    "db:seed:dev": "pnpm --filter @eta/api build && pnpm --filter @eta/api seed:dev"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "turbo": "^2.11.10"
  }
}
